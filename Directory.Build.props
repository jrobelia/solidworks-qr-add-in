<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Single architecture for the whole solution: SolidWorks is a 64-bit host.
         Default Platform too — a bare `dotnet build <project>` must produce the
         same bin\x64 output the solution build does. -->
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>

    <!-- Reproducible restore (spec: "verify the selected NuGet assets during
         restore/build"). Every project writes a committed packages.lock.json;
         restoring in locked mode (dotnet restore locked-mode flag) fails when
         a project file drifts from its lock file instead of silently
         resolving different assets. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
